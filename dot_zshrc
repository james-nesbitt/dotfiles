# XDG Base Directory Specification
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# Path to your Oh My Zsh installation.
export ZSH="$XDG_DATA_HOME/oh-my-zsh"

# Zsh Completion Cache XDG
export ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump-$HOST-$ZSH_VERSION"
mkdir -p "$XDG_CACHE_HOME/zsh"

# NPM & Node XDG Setup
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export NODE_REPL_HISTORY="$XDG_STATE_HOME/node_repl_history"
export NODE_PATH="$HOME/.local/lib/node_modules:$NODE_PATH"

# Rust/Cargo XDG Setup
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"

# Go XDG Setup
export GOPATH="$XDG_DATA_HOME/go"

# Bun XDG Setup
export BUN_INSTALL="$HOME/.local/share/bun"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# Docker XDG Setup
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"

# Ollama XDG Setup
export OLLAMA_MODELS="$XDG_DATA_HOME/ollama/models"

# Update PATH
for dir in "$BUN_INSTALL/bin" "$GOPATH/bin" "$CARGO_HOME/bin" "$HOME/.local/bin"; do
  if [ -d "$dir" ]; then
    export PATH="$dir:$PATH"
  fi
done

# Set name of the theme to load
ZSH_THEME="robbyrussell"

# Recommended Plugins for your stack
available_plugins=(containerenv distrobox git)

# Conditionally add plugins if the associated binary is found
[[ -n "$(command -v bun)" ]]     && available_plugins+=(bun)
[[ -n "$(command -v cargo)" ]]     && available_plugins+=(rust)
[[ -n "$(command -v go)" ]]        && available_plugins+=(golang)
[[ -n "$(command -v npm)" ]]       && available_plugins+=(npm node)
[[ -n "$(command -v docker)" ]]    && available_plugins+=(docker docker-compose)
[[ -n "$(command -v terraform)" ]] && available_plugins+=(terraform)

plugins=($available_plugins)

source $ZSH/oh-my-zsh.sh

# User configuration
RPROMPT='%n@%m $(containerenv_prompt_info)'

# Preferred editor for local and remote sessions
if [[ -n "$(command -v nvim)" ]]; then
  export EDITOR='nvim'
else
  export EDITOR='vi'
fi

# Linuxbrew initialization
if [ -d "/home/linuxbrew/.linuxbrew" ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
fi

# LM Studio XDG
export LMSTUDIO_HOME="$XDG_DATA_HOME/lmstudio"

# n8n XDG
export N8N_USER_FOLDER="$XDG_DATA_HOME/n8n"

# RedHat XDG
export REDHAT_HOME="$XDG_CONFIG_HOME/redhat"

